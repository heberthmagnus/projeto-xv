generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String             @id @default(uuid())
  name                     String?
  email                    String             @unique
  password                 String
  supabaseAuthId           String?            @unique
  role                     String             @default("USER")
  createdAt                DateTime           @default(now())
  roles                    UserRole[]
  member                   Member?
  createdMemberInvitations MemberInvitation[] @relation("MemberInvitationCreator")
}

enum PlatformRole {
  ROOT
  DIRETORIA
  SECRETARIA
  ASSOCIADO
}

enum MembershipStatus {
  ATIVO
  INATIVO
  SUSPENSO
}

enum MembershipCategory {
  PROPRIETARIO
  FAMILIAR
}

enum AccountRequestStatus {
  PENDENTE
  APROVADO
  RECUSADO
}

enum PredictionPoolCategory {
  ADULTO
  MASTER
}

enum PermanentTeamCategory {
  LIVRE
  MAIS_38
  MAIS_48
  MAIS_58
}

enum InterclubesFixtureType {
  AMISTOSO
  INTERCLUBES
}

enum MemberInvitationStatus {
  PENDENTE
  ACEITO
  CANCELADO
  EXPIRADO
}

model AccountRequest {
  id             String               @id @default(uuid())
  fullName       String
  email          String
  phone          String
  passwordHash   String
  supabaseAuthId String?              @unique
  status         AccountRequestStatus @default(PENDENTE)
  createdAt      DateTime             @default(now())
  decidedAt      DateTime?
  decidedBy      String?

  @@index([status, createdAt])
}

model RequestRateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

model AuthEmailDelivery {
  webhookId String   @id
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model UserRole {
  userId String
  role   PlatformRole
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
}

model Member {
  id                     String                      @id @default(uuid())
  userId                 String?                     @unique
  fullName               String
  email                  String?                     @unique
  phone                  String?
  category               MembershipCategory
  status                 MembershipStatus            @default(ATIVO)
  membershipCode         String?                     @unique
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  user                   User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  athleteProfile         AthleteProfile?
  predictionParticipants PredictionPoolParticipant[]
}

model AdministrativeAudit {
  id        String   @id @default(uuid())
  actorId   String
  action    String
  target    String
  previous  Json?
  next      Json?
  createdAt DateTime @default(now())

  @@index([target, createdAt])
}

model SiteSuggestion {
  id           String   @id @default(uuid())
  name         String?
  contact      String?
  subject      String
  message      String
  allowContact Boolean  @default(false)
  status       String   @default("NOVO")
  adminNotes   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
}

model AthleteProfile {
  id                  String                     @id @default(uuid())
  fullName            String
  normalizedFullName  String                     @unique
  nickname            String?
  preferredPosition   PreferredPosition?
  birthDate           DateTime?
  lastKnownAge        Int?
  defaultLevel        PlayerLevel?
  phone               String?
  email               String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  peladaArrivals      PeladaArrival[]
  peladaConfirmations PeladaConfirmation[]
  registrations       Registration[]
  matchEvents         MatchEvent[]
  matchParticipations MatchPlayerParticipation[]
  suspensions         Suspension[]
  memberId            String?                    @unique
  member              Member?                    @relation(fields: [memberId], references: [id], onDelete: SetNull)
  permanentTeamMemberships PermanentTeamMembership[]
  interclubesFixturePlayers InterclubesFixturePlayer[]
}

/// Equipe contínua do Clube XV. Não representa um elenco de campeonato.
model PermanentTeam {
  id                  String                  @id @default(uuid())
  category            PermanentTeamCategory   @unique
  name                String
  activeForInterclubes Boolean                @default(false)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  memberships         PermanentTeamMembership[]
  fixtures            InterclubesFixture[]
}

/// Histórico de vínculo de um atleta com um time permanente.
model PermanentTeamMembership {
  id               String         @id @default(uuid())
  permanentTeamId  String
  athleteProfileId String
  joinedAt         DateTime       @default(now())
  leftAt           DateTime?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  permanentTeam    PermanentTeam  @relation(fields: [permanentTeamId], references: [id], onDelete: Cascade)
  athleteProfile   AthleteProfile @relation(fields: [athleteProfileId], references: [id], onDelete: Restrict)

  @@index([permanentTeamId, leftAt])
  @@index([athleteProfileId, leftAt])
}

/// Agenda de amistosos e partidas oficiais dos times permanentes.
model InterclubesFixture {
  id              String                 @id @default(uuid())
  permanentTeamId String
  type            InterclubesFixtureType
  opponentName    String
  scheduledAt     DateTime
  location        String?
  notes           String?
  homeGame        Boolean                @default(true)
  status          MatchStatus            @default(AGENDADO)
  clubScore       Int?
  opponentScore   Int?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  permanentTeam   PermanentTeam          @relation(fields: [permanentTeamId], references: [id], onDelete: Cascade)
  players         InterclubesFixturePlayer[]

  @@index([permanentTeamId, scheduledAt])
  @@index([scheduledAt, status])
}

/// Participação e estatísticas exclusivamente do Clube XV em uma partida da agenda.
model InterclubesFixturePlayer {
  id          String              @id @default(uuid())
  fixtureId   String
  athleteId   String
  played      Boolean             @default(false)
  starter     Boolean             @default(false)
  goals       Int                 @default(0)
  yellowCards Int                 @default(0)
  blueCards   Int                 @default(0)
  redCards    Int                 @default(0)
  fixture     InterclubesFixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  athlete     AthleteProfile      @relation(fields: [athleteId], references: [id], onDelete: Restrict)

  @@unique([fixtureId, athleteId])
  @@index([athleteId])
}

model Championship {
  id                String                       @id @default(uuid())
  name              String
  slug              String                       @unique
  createdAt         DateTime                     @default(now())
  description       String?
  endsAt            DateTime?
  format            ChampionshipFormat           @default(PONTOS_CORRIDOS)
  registrationMode  ChampionshipRegistrationMode @default(INDIVIDUAL)
  seasonLabel       String?
  startsAt          DateTime?
  status            ChampionshipStatus           @default(RASCUNHO)
  updatedAt         DateTime                     @default(now()) @updatedAt
  players           ChampionshipPlayer[]
  stages            ChampionshipStage[]
  teams             ChampionshipTeam[]
  matches           Match[]
  registrations     Registration[]
  standings         Standing[]
  suspensions       Suspension[]
  teamRelationships TeamRelationship[]
  teamSimulations   TeamSimulation[]
  predictionPools   PredictionPool[]
}

model Team {
  id                  String                     @id @default(uuid())
  name                String
  createdAt           DateTime                   @default(now())
  crestUrl            String?
  icon                String?
  primaryColor        String?
  secondaryColor      String?
  shortName           String?
  slug                String?                    @unique
  updatedAt           DateTime                   @default(now()) @updatedAt
  players             ChampionshipPlayer[]
  championships       ChampionshipTeam[]
  awayMatches         Match[]                    @relation("AwayTeam")
  homeMatches         Match[]                    @relation("HomeTeam")
  events              MatchEvent[]
  matchParticipations MatchPlayerParticipation[]
  standings           Standing[]
  suspensions         Suspension[]
}

model ChampionshipTeam {
  id             String                    @id @default(uuid())
  championshipId String
  teamId         String
  displayOrder   Int?
  groupLabel     String?
  seed           Int?
  shirtImageUrl  String?
  championship   Championship              @relation(fields: [championshipId], references: [id])
  team           Team                      @relation(fields: [teamId], references: [id])
  sponsors       ChampionshipTeamSponsor[]

  @@unique([championshipId, teamId])
}

model Sponsor {
  id           String                    @id @default(uuid())
  name         String
  logoUrl      String
  websiteUrl   String?
  instagramUrl String?
  whatsapp     String?
  description  String?
  active       Boolean                   @default(true)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  sponsorships ChampionshipTeamSponsor[]

  @@index([active])
}

model MemberInvitation {
  id          String                 @id @default(uuid())
  email       String
  tokenHash   String                 @unique
  status      MemberInvitationStatus @default(PENDENTE)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime               @default(now())
  createdById String
  createdBy   User                   @relation("MemberInvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([email, status])
  @@index([expiresAt])
}

model PredictionPool {
  id             String                      @id @default(uuid())
  championshipId String
  category       PredictionPoolCategory
  active         Boolean                     @default(true)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  championship   Championship                @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  participants   PredictionPoolParticipant[]
  matches        PredictionPoolMatch[]
  multipliers    PredictionMultiplier[]

  @@unique([championshipId, category])
  @@index([active, category])
}

model PredictionPoolParticipant {
  id                String                 @id @default(uuid())
  poolId            String
  memberId          String
  firstPredictionAt DateTime?
  joinedAt          DateTime               @default(now())
  pool              PredictionPool         @relation(fields: [poolId], references: [id], onDelete: Cascade)
  member            Member                 @relation(fields: [memberId], references: [id], onDelete: Restrict)
  predictions       Prediction[]
  multipliers       PredictionMultiplier[]

  @@unique([poolId, memberId])
  @@index([memberId, joinedAt])
}

/// Snapshot do prazo por jogo dentro do Bolão. Ele impede reabrir palpites
/// quando o jogo é reagendado depois do fechamento original.
model PredictionPoolMatch {
  id          String                 @id @default(uuid())
  poolId      String
  matchId     String
  lockAt      DateTime
  lockedAt    DateTime?
  eligible    Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  pool        PredictionPool         @relation(fields: [poolId], references: [id], onDelete: Cascade)
  match       Match                  @relation(fields: [matchId], references: [id], onDelete: Restrict)
  predictions Prediction[]
  multipliers PredictionMultiplier[]

  @@unique([poolId, matchId])
  @@index([poolId, lockAt])
  @@index([matchId])
}

model Prediction {
  id            String                    @id @default(uuid())
  participantId String
  poolMatchId   String
  homeGoals     Int
  awayGoals     Int
  basePoints    Int                       @default(0)
  awardedPoints Int                       @default(0)
  scoredAt      DateTime?
  submittedAt   DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  participant   PredictionPoolParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  poolMatch     PredictionPoolMatch       @relation(fields: [poolMatchId], references: [id], onDelete: Cascade)

  @@unique([participantId, poolMatchId])
  @@index([poolMatchId, scoredAt])
}

model PredictionMultiplier {
  id            String                    @id @default(uuid())
  participantId String
  poolId        String
  poolMatchId   String
  round         Int
  lockedAt      DateTime?
  selectedAt    DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  participant   PredictionPoolParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  pool          PredictionPool            @relation(fields: [poolId], references: [id], onDelete: Cascade)
  poolMatch     PredictionPoolMatch       @relation(fields: [poolMatchId], references: [id], onDelete: Restrict)

  @@unique([participantId, poolId, round])
  @@index([poolMatchId])
}

model SiteBacklogItem {
  id          String            @id @default(uuid())
  title       String
  description String
  area        String
  status      SiteBacklogStatus @default(BACKLOG)
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, sortOrder])
}

model ChampionshipTeamSponsor {
  id                 String           @id @default(uuid())
  championshipTeamId String
  sponsorId          String
  isPrimary          Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  championshipTeam   ChampionshipTeam @relation(fields: [championshipTeamId], references: [id], onDelete: Cascade)
  sponsor            Sponsor          @relation(fields: [sponsorId], references: [id], onDelete: Restrict)

  @@unique([championshipTeamId, sponsorId])
  @@index([championshipTeamId, isPrimary])
  @@index([sponsorId])
}

model ChampionshipStage {
  id             String                @id @default(uuid())
  championshipId String
  name           String
  order          Int
  stageType      ChampionshipStageType
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @default(now()) @updatedAt
  championship   Championship          @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  matches        Match[]

  @@unique([championshipId, order])
}

model ChampionshipPlayer {
  id             String                   @id @default(uuid())
  championshipId String
  registrationId String                   @unique
  teamId         String?
  squadNumber    Int?
  rosterOrder    Int?
  status         ChampionshipPlayerStatus @default(ATIVO)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @default(now()) @updatedAt
  championship   Championship             @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  registration   Registration             @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  team           Team?                    @relation(fields: [teamId], references: [id])

  @@index([championshipId, teamId])
  @@index([teamId])
}

model Match {
  id                    String                     @id @default(uuid())
  championshipId        String
  homeTeamId            String
  awayTeamId            String
  homeScore             Int?
  awayScore             Int?
  round                 Int
  createdAt             DateTime                   @default(now())
  location              String?
  notes                 String?
  matchReport           String?
  referee               String?
  roundNumber           Int?
  scheduledAt           DateTime?
  stageId               String?
  status                MatchStatus                @default(AGENDADO)
  updatedAt             DateTime                   @default(now()) @updatedAt
  awayTeam              Team                       @relation("AwayTeam", fields: [awayTeamId], references: [id])
  championship          Championship               @relation(fields: [championshipId], references: [id])
  homeTeam              Team                       @relation("HomeTeam", fields: [homeTeamId], references: [id])
  stage                 ChampionshipStage?         @relation(fields: [stageId], references: [id])
  events                MatchEvent[]
  participations        MatchPlayerParticipation[]
  suspensions           Suspension[]
  predictionPoolMatches PredictionPoolMatch[]
}

model Standing {
  id             String           @id @default(uuid())
  championshipId String
  teamId         String
  points         Int              @default(0)
  wins           Int              @default(0)
  draws          Int              @default(0)
  losses         Int              @default(0)
  goalsFor       Int              @default(0)
  goalsAgainst   Int              @default(0)
  gamesPlayed    Int              @default(0)
  goalDifference Int              @default(0)
  movement       StandingMovement @default(MANTEVE)
  rank           Int?
  winRate        Int              @default(0)
  championship   Championship     @relation(fields: [championshipId], references: [id])
  team           Team             @relation(fields: [teamId], references: [id])

  @@unique([championshipId, teamId])
}

model MatchEvent {
  id          String          @id @default(uuid())
  matchId     String
  player      String
  minute      Int?
  notes       String?
  quantity    Int             @default(1)
  teamId      String?
  playerId    String?
  type        MatchEventType
  match       Match           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team        Team?           @relation(fields: [teamId], references: [id])
  athlete     AthleteProfile? @relation(fields: [playerId], references: [id])
  suspensions Suspension[]

  @@index([matchId])
  @@index([playerId])
  @@index([teamId])
}

model Suspension {
  id               String           @id @default(uuid())
  championshipId   String
  playerId         String
  teamId           String
  reason           String
  relatedEventId   String?
  relatedMatchId   String?
  matchesSuspended Int              @default(1)
  status           SuspensionStatus @default(ATIVA)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  championship     Championship     @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  player           AthleteProfile   @relation(fields: [playerId], references: [id])
  team             Team             @relation(fields: [teamId], references: [id])
  relatedEvent     MatchEvent?      @relation(fields: [relatedEventId], references: [id])
  relatedMatch     Match?           @relation(fields: [relatedMatchId], references: [id])

  @@index([championshipId, status])
  @@index([playerId])
  @@index([teamId])
  @@index([relatedEventId])
  @@index([relatedMatchId])
}

model MatchPlayerParticipation {
  id            String         @id @default(uuid())
  matchId       String
  playerId      String
  teamId        String
  starter       Boolean        @default(false)
  bionic        Boolean        @default(false)
  goals         Int            @default(0)
  assists       Int?
  yellowCards   Int            @default(0)
  redCards      Int            @default(0)
  ownGoals      Int            @default(0)
  mvp           Boolean        @default(false)
  minutesPlayed Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  match         Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player        AthleteProfile @relation(fields: [playerId], references: [id])
  team          Team           @relation(fields: [teamId], references: [id])

  @@unique([matchId, playerId, teamId])
  @@index([playerId])
  @@index([teamId])
}

model Registration {
  id                 String                @id @default(uuid())
  championshipId     String
  fullName           String
  nickname           String?
  category           RegistrationCategory?
  preferredPosition  PreferredPosition
  birthDate          DateTime
  phone              String
  email              String?
  level              PlayerLevel?
  adminNotes         String?
  confirmedRules     Boolean
  createdAt          DateTime              @default(now())
  paidAt             DateTime?
  paymentStatus      PaymentStatus         @default(PENDENTE)
  athleteProfileId   String?
  championshipPlayer ChampionshipPlayer?
  athleteProfile     AthleteProfile?       @relation(fields: [athleteProfileId], references: [id])
  championship       Championship          @relation(fields: [championshipId], references: [id])
  relationshipsAsA   TeamRelationship[]    @relation("RelationshipPlayerA")
  relationshipsAsB   TeamRelationship[]    @relation("RelationshipPlayerB")

  @@index([championshipId])
  @@index([championshipId, category])
  @@index([athleteProfileId])
}

/// A category-scoped, extensible link between two championship registrations.
/// `relationshipType` is deliberately a string so new business labels require no migration.
model TeamRelationship {
  id               String               @id @default(uuid())
  championshipId   String
  category         RegistrationCategory
  playerAId        String
  playerBId        String
  relationshipType String
  priorityWeight   Int                  @default(1)
  notes            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  championship     Championship         @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  playerA          Registration         @relation("RelationshipPlayerA", fields: [playerAId], references: [id], onDelete: Cascade)
  playerB          Registration         @relation("RelationshipPlayerB", fields: [playerBId], references: [id], onDelete: Cascade)

  @@unique([championshipId, playerAId, playerBId])
  @@index([championshipId, category])
}

/// Snapshot of an explicitly saved in-memory Campão simulation.
model TeamSimulation {
  id             String               @id @default(uuid())
  championshipId String
  category       RegistrationCategory
  name           String
  settings       Json
  teams          Json
  statistics     Json
  balanceScore   Int
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  championship   Championship         @relation(fields: [championshipId], references: [id], onDelete: Cascade)

  @@index([championshipId, category, updatedAt])
}

model Pelada {
  id                   String                 @id @default(uuid())
  scheduledAt          DateTime
  type                 PeladaType
  firstGameRule        FirstGameRule
  arrivalCutoffTime    String?
  maxFirstGamePlayers  Int?
  linePlayersCount     Int
  status               PeladaStatus           @default(ABERTA)
  notes                String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  roundDurationMinutes Int                    @default(20)
  arrivals             PeladaArrival[]
  confirmations        PeladaConfirmation[]
  rounds               PeladaRound[]
  teamAssignments      PeladaTeamAssignment[]

  @@index([scheduledAt])
  @@index([status])
}

model PeladaConfirmation {
  id                   String               @id @default(uuid())
  peladaId             String
  fullName             String
  preferredPosition    PreferredPosition
  age                  Int?
  guestCount           Int                  @default(0)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  createdByAdmin       Boolean              @default(false)
  cancelToken          String?              @unique
  canceledAt           DateTime?
  goalkeeperSide       GoalkeeperSide?
  guestOrder           Int?
  level                PlayerLevel?
  parentConfirmationId String?
  athleteProfileId     String?
  arrivals             PeladaArrival[]
  athleteProfile       AthleteProfile?      @relation(fields: [athleteProfileId], references: [id])
  parentConfirmation   PeladaConfirmation?  @relation("PeladaConfirmationGuests", fields: [parentConfirmationId], references: [id], onDelete: Cascade)
  guests               PeladaConfirmation[] @relation("PeladaConfirmationGuests")
  pelada               Pelada               @relation(fields: [peladaId], references: [id], onDelete: Cascade)

  @@unique([parentConfirmationId, guestOrder])
  @@index([peladaId])
  @@index([athleteProfileId])
  @@index([parentConfirmationId])
}

model PeladaArrival {
  id                    String                @id @default(uuid())
  peladaId              String
  confirmationId        String?
  fullName              String
  preferredPosition     PreferredPosition
  age                   Int?
  arrivalOrder          Int
  playsFirstGame        Boolean               @default(false)
  playsSecondGame       Boolean               @default(false)
  level                 PlayerLevel?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  arrivedAt             DateTime              @default(now())
  availableForNextRound Boolean               @default(false)
  guestInvitedBy        String?
  isGuest               Boolean               @default(false)
  outForDay             Boolean               @default(false)
  athleteProfileId      String?
  athleteProfile        AthleteProfile?       @relation(fields: [athleteProfileId], references: [id])
  confirmation          PeladaConfirmation?   @relation(fields: [confirmationId], references: [id], onDelete: Cascade)
  pelada                Pelada                @relation(fields: [peladaId], references: [id], onDelete: Cascade)
  roundPlayers          PeladaRoundPlayer[]
  teamAssignment        PeladaTeamAssignment?

  @@unique([peladaId, arrivalOrder])
  @@index([peladaId])
  @@index([athleteProfileId])
  @@index([confirmationId])
}

model PeladaTeamAssignment {
  id               String             @id @default(uuid())
  peladaId         String
  arrivalId        String             @unique
  teamColor        PeladaTeamColor
  assignedPosition PreferredPosition?
  isFallback       Boolean            @default(false)
  displayOrder     Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  arrival          PeladaArrival      @relation(fields: [arrivalId], references: [id], onDelete: Cascade)
  pelada           Pelada             @relation(fields: [peladaId], references: [id], onDelete: Cascade)

  @@unique([peladaId, teamColor, displayOrder])
  @@index([peladaId, teamColor])
}

model PeladaRound {
  id          String              @id @default(uuid())
  peladaId    String
  roundNumber Int
  status      PeladaRoundStatus   @default(ATIVA)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  blackScore  Int                 @default(0)
  notes       String?
  yellowScore Int                 @default(0)
  startedAt   DateTime?
  pelada      Pelada              @relation(fields: [peladaId], references: [id], onDelete: Cascade)
  goals       PeladaRoundGoal[]
  players     PeladaRoundPlayer[]

  @@unique([peladaId, roundNumber])
  @@index([peladaId, status])
}

model PeladaRoundPlayer {
  id         String                  @id @default(uuid())
  roundId    String
  arrivalId  String
  source     PeladaRoundPlayerSource
  queueOrder Int
  createdAt  DateTime                @default(now())
  teamColor  PeladaTeamColor?
  goals      PeladaRoundGoal[]
  arrival    PeladaArrival           @relation(fields: [arrivalId], references: [id], onDelete: Cascade)
  round      PeladaRound             @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, arrivalId])
  @@unique([roundId, queueOrder])
  @@index([arrivalId])
}

model PeladaRoundGoal {
  id            String             @id @default(uuid())
  roundId       String
  scorerName    String
  teamColor     PeladaTeamColor
  minute        Int?
  createdAt     DateTime           @default(now())
  roundPlayerId String?
  round         PeladaRound        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  roundPlayer   PeladaRoundPlayer? @relation(fields: [roundPlayerId], references: [id])

  @@index([roundPlayerId])
  @@index([roundId, teamColor])
}

